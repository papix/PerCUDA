requires 'perl', '5.040000';
requires 'Carp';
requires 'Digest::MD5';
requires 'Exporter';
requires 'File::Path';
requires 'File::Spec';
requires 'File::Temp';
requires 'List::Util';
requires 'Scalar::Util';
requires 'parent';

# Only the gpu engine needs it (https://github.com/papix/CUDA-DriverAPI);
# without it, kernels run on the perl engine.
recommends 'CUDA::DriverAPI', '0.02';

# Array arguments may be PDL ndarrays; PerCUDA never loads PDL itself.
suggests 'PDL', '2.100';

on 'configure' => sub {
    requires 'Module::Build::Tiny', '0.053';
};

on 'test' => sub {
    requires 'Test2::V0';
    recommends 'PDL', '2.100';    # t/08_pdl.t skips without it
};

on 'develop' => sub {
    requires 'Minilla', 'v3.3.2';
    requires 'Perl::Critic', '1.156';
    requires 'Perl::Tidy', '20260826';
    requires 'Test::Perl::Critic', '1.04';
    # Release tests generated by Minilla (xt/minilla/*)
    requires 'Test::CPAN::Meta', '0.25';
    requires 'Test::MinimumVersion::Fast', '0.04';
    requires 'Test::PAUSE::Permissions', '0.07';
    requires 'Test::Pod', '1.52';
    requires 'Test::Spellunker', 'v0.4.0';
};
